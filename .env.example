# Public content reads. Use a development Supabase project or approved branch.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only form storage and CRM synchronization.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
HUBSPOT_PRIVATE_APP_TOKEN=your-private-app-token

# Inbound lead notifications (server-only). Email is sent through Resend when
# both RESEND_API_KEY and FORM_NOTIFY_TO are set; otherwise it is skipped and
# logged. FORM_NOTIFY_FROM must use a domain verified in Resend.
RESEND_API_KEY=re_your-sending-key
FORM_NOTIFY_TO=you@example.com,teammate@example.com
FORM_NOTIFY_FROM="ZINC Website <forms@wearezinc.com>"
# HubSpot owner assigned to every new website contact (find via Settings → Users).
HUBSPOT_OWNER_ID=11670892
